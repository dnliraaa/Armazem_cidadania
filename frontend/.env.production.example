# ============================================================================
# Frontend — PRODUÇÃO. Copie para frontend/.env.production e preencha ANTES do build.
#   cp frontend/.env.production.example frontend/.env.production
# O Vite grava estes valores no JavaScript gerado: só coloque aqui o que pode ser público.
# (A ANON_KEY é pública por natureza; a SERVICE_ROLE_KEY NUNCA entra aqui.)
# ============================================================================

# API do backend (o Nginx encaminha /api para o Node)
VITE_API_URL=https://armazemdacidadania.tech/api

# API do Supabase self-hosted (somente /auth/v1 é exposto publicamente pelo Nginx)
VITE_SUPABASE_URL=https://db.armazemdacidadania.tech

# ANON_KEY de deploy/supabase/.env
VITE_SUPABASE_ANON_KEY=cole-a-ANON_KEY-aqui
