# ============================================================================
# Supabase self-hosted — Armazém da Cidadania
# ============================================================================
# NÃO preencha este arquivo à mão: rode  ./gerar-segredos.sh  — ele cria o .env de verdade
# (ao lado deste) com senhas fortes e as chaves JWT já assinadas. Este modelo só documenta
# cada campo. O .env real NUNCA vai para o git (já está no .gitignore).

# --- Banco de dados ---------------------------------------------------------
# Senha do Postgres (e dos roles internos). Só letras/números, para não quebrar as URLs de conexão.
POSTGRES_PASSWORD=gerado-por-gerar-segredos.sh

# --- JWT (a base de toda a autenticação) ------------------------------------
# Segredo de assinatura, com pelo menos 32 caracteres. Se for trocado, ANON_KEY e SERVICE_ROLE_KEY
# precisam ser regeradas, e todos os usuários logados precisam entrar de novo.
JWT_SECRET=gerado-por-gerar-segredos.sh
# Validade do token de acesso, em segundos (o supabase-js renova sozinho).
JWT_EXPIRY=3600

# Chaves JWT (HS256) assinadas com o JWT_SECRET, com role anon e service_role.
# ANON_KEY é PÚBLICA (vai no frontend). SERVICE_ROLE_KEY dá acesso total ao banco: só no backend.
ANON_KEY=gerado-por-gerar-segredos.sh
SERVICE_ROLE_KEY=gerado-por-gerar-segredos.sh

# Chave do postgres-meta (usado pelo Studio) para criptografar dados internos. Aleatória, >= 32 caracteres.
PG_META_CRYPTO_KEY=gerado-por-gerar-segredos.sh

# --- URLs --------------------------------------------------------------------
# Domínio do sistema (frontend). É para onde o Auth considera que o usuário "volta".
SITE_URL=https://armazemdacidadania.tech
# URL pública da API do Supabase (Auth). Entra nos tokens e nos links gerados pelo Auth.
API_EXTERNAL_URL=https://db.armazemdacidadania.tech
# URLs extras permitidas para redirecionamento (vazio = só o SITE_URL).
ADDITIONAL_REDIRECT_URLS=

# --- Portas (SEMPRE publicadas só em 127.0.0.1 pelo docker-compose) -----------
KONG_HTTP_PORT=8000
STUDIO_PORT=3000

# --- Studio (painel web) ------------------------------------------------------
# O Studio não é exposto na internet (túnel SSH). Estas credenciais ficam guardadas para o caso de
# você querer protegê-lo atrás do Kong no futuro; hoje não são usadas pelo compose enxuto.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=gerado-por-gerar-segredos.sh
