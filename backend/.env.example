# URL do seu projeto Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave "service_role" (Project Settings > API > Project API keys)
# NUNCA exponha esta chave no frontend. Ela dá acesso total ao banco.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Chave "anon" (usada apenas para validar o token do usuário logado)
SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Porta em que a API vai rodar
PORT=3333

# URL do frontend, usada para liberar CORS (separe por vírgula se houver mais de uma)
FRONTEND_URL=http://localhost:5173
