# ============================================================================
# Backend — PRODUÇÃO (VPS). Copie para backend/.env e preencha. NUNCA commite o .env.
#   cp backend/.env.production.example backend/.env && chmod 600 backend/.env
# ============================================================================

NODE_ENV=production

# Supabase self-hosted: o backend roda na MESMA máquina e fala com o Kong direto pelo
# loopback (sem passar pela internet/TLS). O Kong escuta só em 127.0.0.1:8000.
SUPABASE_URL=http://127.0.0.1:8000

# As duas chaves vêm de deploy/supabase/.env (geradas por gerar-segredos.sh).
# A service_role dá acesso TOTAL ao banco: nunca vai para o frontend.
SUPABASE_SERVICE_ROLE_KEY=cole-a-SERVICE_ROLE_KEY-aqui
SUPABASE_ANON_KEY=cole-a-ANON_KEY-aqui

# A API escuta só no loopback; quem a alcança é o Nginx (proxy de /api).
HOST=127.0.0.1
PORT=3333

# CORS: SÓ o domínio do sistema (separe por vírgula se houver mais de um).
FRONTEND_URL=https://armazemdacidadania.tech
